import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class ClubSimulation extends JFrame {
    private final int gridSize = 10; // Size of the grid
    private final int numPatrons = 20; // Total number of patrons
    private volatile boolean simulationRunning = false;

    private JButton startButton;
    private JButton pauseButton;
    private JButton quitButton;
    private JLabel waitingLabel;
    private JLabel insideLabel;
    private JLabel leftLabel;

    private int patronsInside = 0;
    private int patronsLeft = 0;
    private int patronsWaiting = 0;

    public ClubSimulation() {
        setTitle("Club Simulation");
        setSize(800, 600);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        JPanel controlPanel = new JPanel();
        startButton = new JButton("Start");
        pauseButton = new JButton("Pause");
        quitButton = new JButton("Quit");
        controlPanel.add(startButton);
        controlPanel.add(pauseButton);
        controlPanel.add(quitButton);

        JPanel infoPanel = new JPanel();
        waitingLabel = new JLabel("Waiting: 0");
        insideLabel = new JLabel("Inside: 0");
        leftLabel = new JLabel("Left: 0");
        infoPanel.add(waitingLabel);
        infoPanel.add(insideLabel);
        infoPanel.add(leftLabel);

        add(controlPanel, BorderLayout.NORTH);
        add(infoPanel, BorderLayout.SOUTH);

        startButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                startSimulation();
            }
        });

        pauseButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                simulationRunning = !simulationRunning;
            }
        });

        quitButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                System.exit(0);
            }
        });
    }

    private void updateLabels() {
        SwingUtilities.invokeLater(() -> {
            waitingLabel.setText("Waiting: " + patronsWaiting);
            insideLabel.setText("Inside: " + patronsInside);
            leftLabel.setText("Left: " + patronsLeft);
        });
    }

    private void startSimulation() {
        simulationRunning = true;

        for (int i = 0; i < numPatrons; i++) {
            Patron patron = new Patron();
            patron.start();
        }

        while (patronsLeft < numPatrons) {
            if (simulationRunning) {
                updateLabels();
            }

            try {
                Thread.sleep(1000); // Simulate the passage of time
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }

    private class Patron extends Thread {
        private boolean inside = false;
        private boolean left = false;

        public void run() {
            try {
                patronsWaiting++;
                updateLabels();

                while (!inside) {
                    if (simulationRunning) {
                        if (inside) {
                            patronsInside++;
                            patronsWaiting--;
                            updateLabels();

                            // Simulate patron's activities inside the club
                            Thread.sleep(2000);

                            inside = true;
                        }
                    }
                }

                if (inside && !left) {
                    patronsInside--;
                    patronsLeft++;
                    updateLabels();
                }
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            ClubSimulation simulation = new ClubSimulation();
            simulation.setVisible(true);
        });
    }
}
